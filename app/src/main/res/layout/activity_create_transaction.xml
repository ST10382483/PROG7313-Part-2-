<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071A2F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="BudTrackr"
            android:textColor="#2EAD5B"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Create new Transaction"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ICON SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:text="Choose an icon:"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnCar"
                    android:text="🚗"
                    android:textSize="28sp"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1" />

                <Button
                    android:id="@+id/btnFood"
                    android:text="🍽"
                    android:textSize="28sp"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1" />

                <Button
                    android:id="@+id/btnShopping"
                    android:text="🛒"
                    android:textSize="28sp"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1" />

                <Button
                    android:id="@+id/btnBag"
                    android:text="🛍"
                    android:textSize="28sp"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1" />

                <Button
                    android:id="@+id/btnMoney"
                    android:text="💵"
                    android:textSize="28sp"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1" />

                <Button
                    android:id="@+id/btnHome"
                    android:text="🏠"
                    android:textSize="28sp"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1" />

            </GridLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/edtTitle"
            android:hint="Enter Title"
            android:background="@android:color/white"
            android:padding="14dp"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtAmount"
            android:hint="Enter Amount"
            android:inputType="numberDecimal"
            android:background="@android:color/white"
            android:padding="14dp"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnAddTransaction"
            android:text="Add\nTransaction"
            android:backgroundTint="#2EAD5B"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_width="160dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:layout_marginTop="26dp" />

    </LinearLayout>
</ScrollView>