<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/logo"/>
    </LinearLayout>

    <!-- Delete account card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete account"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"/>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Are you sure you want to delete your account ?"
                android:textColor="#000000"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Password instruction -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please enter your Password to confirm:"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <!-- Warning -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WARNING"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You will loose all your data collected"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"/>

            <!-- Password input -->
            <EditText
                android:id="@+id/deletePasswordField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#E8F5E9"
                android:inputType="textPassword"
                android:padding="8dp"
                android:layout_marginBottom="24dp"/>

            <!-- Go back button -->
            <Button
                android:id="@+id/goBackHomeBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Go back to the Home Page"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:stateListAnimator="@null"
                android:layout_marginBottom="12dp"/>

            <!-- Delete account button -->
            <Button
                android:id="@+id/deleteAccountBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Delete Account"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                android:stateListAnimator="@null"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#0D1B2A"
        android:gravity="center">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0D1B2A"
            android:src="@mipmap/home"
            android:scaleType="fitCenter"
            android:padding="12dp"/>

        <ImageButton
            android:id="@+id/navTransactions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0D1B2A"
            android:src="@mipmap/transaction"
            android:scaleType="fitCenter"
            android:padding="12dp"/>

        <ImageButton
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0D1B2A"
            android:src="@mipmap/account"
            android:scaleType="fitCenter"
            android:padding="12dp"/>

        <ImageButton
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0D1B2A"
            android:src="@mipmap/notification"
            android:scaleType="fitCenter"
            android:padding="12dp"/>

    </LinearLayout>

</LinearLayout>